# Boulder DEVELOPMENT configuration for integration testing

# This is a placeholder configuration. In a real deployment, this would
# be managed by the Helm chart with environment-specific values.

# For now, we will use a simple configuration that is sufficient
# to run the integration tests.

# Note: This is not a complete Boulder configuration. It only includes
# the minimal set of values required to get the integration tests to run.

# The full configuration will be built out in subsequent tasks.

# See: https://github.com/letsencrypt/boulder/blob/main/test/config/testing.json

{ 
  "va": {
    "portConfig": {
      "httpPort": 80,
      "httpsPort": 443,
      "tlsPort": 5001
    }
  },
  "wfe": {
    "listenAddress": ":5002"
  },
  "publisher": {
    "dbconfig": "file:///tmp/publisher.db"
  },
  "sa": {
    "dbconfig": "file:///tmp/sa.db"
  },
  "ca": {
    "dbconfig": "file:///tmp/ca.db"
  }
}
