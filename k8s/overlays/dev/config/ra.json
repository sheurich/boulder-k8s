{
	"ra": {
		"limiter": {
			"redis": {
				"username": "default",
				"passwordFile": "/secrets/redis_password",
				"shardAddrs": {
					"shard1": "redis-master.boulder.svc.cluster.local:6379"
				},
				"readTimeout": "250ms",
				"writeTimeout": "250ms",
				"poolSize": 100,
				"routeRandomly": true,
				"tls": {
					"caCertFile": "/certs/ipki/ca.crt",
					"certFile": "/certs/ipki/ra/cert.pem",
					"keyFile": "/certs/ipki/ra/key.pem"
				}
			},
			"Defaults": "/config/ratelimit-defaults.yml",
			"Overrides": "/config/ratelimit-overrides.yml"
		},
		"maxContactsPerRegistration": 3,
		"debugAddr": ":8002",
		"hostnamePolicyFile": "/config/ident-policy.yaml",
		"goodkey": {},
		"issuerCerts": [
			"/certs/webpki/int-rsa-a.cert.pem",
			"/certs/webpki/int-rsa-b.cert.pem",
			"/certs/webpki/int-rsa-c.cert.pem",
			"/certs/webpki/int-ecdsa-a.cert.pem",
			"/certs/webpki/int-ecdsa-b.cert.pem",
			"/certs/webpki/int-ecdsa-c.cert.pem"
		],
		"validationProfiles": {
			"legacy": {
				"pendingAuthzLifetime": "168h",
				"validAuthzLifetime": "720h",
				"orderLifetime": "168h",
				"maxNames": 100,
				"identifierTypes": [
					"dns"
				]
			},
			"modern": {
				"pendingAuthzLifetime": "7h",
				"validAuthzLifetime": "7h",
				"orderLifetime": "7h",
				"maxNames": 10,
				"identifierTypes": [
					"dns"
				]
			},
			"shortlived": {
				"pendingAuthzLifetime": "7h",
				"validAuthzLifetime": "7h",
				"orderLifetime": "7h",
				"maxNames": 10,
				"identifierTypes": [
					"dns",
					"ip"
				]
			}
		},
		"defaultProfileName": "legacy",
		"tls": {
			"caCertFile": "/certs/ipki/ca.crt",
			"certFile": "/certs/ipki/ra/cert.pem",
			"keyFile": "/certs/ipki/ra/key.pem"
		},
		"vaService": {
			"serverAddress": "boulder-va.boulder.svc.cluster.local:9092",
			"timeout": "20s",
			"noWaitForReady": true,
			"hostOverride": "va.boulder"
		},
		"caService": {
			"serverAddress": "boulder-ca.boulder.svc.cluster.local:9093",
			"timeout": "15s",
			"noWaitForReady": true,
			"hostOverride": "ca.boulder"
		},
		"publisherService": {
			"serverAddress": "boulder-publisher.boulder.svc.cluster.local:9091",
			"timeout": "300s",
			"noWaitForReady": true,
			"hostOverride": "publisher.boulder"
		},
		"saService": {
			"serverAddress": "boulder-sa.boulder.svc.cluster.local:9095",
			"timeout": "15s",
			"noWaitForReady": true,
			"hostOverride": "sa.boulder"
		},
		"grpc": {
			"address": ":9094",
			"maxConnectionAge": "30s",
			"services": {
				"ra.RegistrationAuthority": {
					"clientNames": [
						"admin.boulder",
						"bad-key-revoker.boulder",
						"wfe.boulder",
						"sfe.boulder",
						"boulder-wfe2",
						"boulder-sfe"
					]
				},
				"ra.SCTProvider": {
					"clientNames": [
						"ca.boulder"
					]
				},
				"grpc.health.v1.Health": {
					"clientNames": [
						"health-checker.boulder"
					]
				}
			}
		},
		"features": {
			"AutomaticallyPauseZombieClients": true,
			"NoPendingAuthzReuse": true,
			"EnforceMPIC": true,
			"UnsplitIssuance": true
		},
		"ctLogs": {
			"stagger": "500ms",
			"logListFile": "/config/ct-log-list.json",
			"sctLogs": [
				"A1 Current",
				"A1 Future",
				"A2 Past",
				"A2 Current",
				"B1",
				"B2",
				"C1",
				"D1",
				"E1"
			],
			"infoLogs": [
				"F1"
			],
			"finalLogs": [
				"A1 Current",
				"A1 Future",
				"C1",
				"F1"
			]
		}
	},
	"pa": {
		"challenges": {
			"http-01": true,
			"dns-01": true,
			"tls-alpn-01": true
		},
		"identifiers": {
			"dns": true,
			"ip": true
		}
	},
	"syslog": {
		"stdoutlevel": 6,
		"sysloglevel": -1
	},
	"openTelemetry": {
		"endpoint": "humanlog.boulder.svc.cluster.local:4317",
		"sampleratio": 1
	}
}
