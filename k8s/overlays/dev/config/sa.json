{
	"sa": {
		"db": {
			"dbConnectFile": "/secrets/sa_dburl",
			"maxOpenConns": 100
		},
		"readOnlyDB": {
			"dbConnectFile": "/secrets/sa_ro_dburl",
			"maxOpenConns": 100
		},
		"incidentsDB": {
			"dbConnectFile": "/secrets/incidents_dburl",
			"maxOpenConns": 100
		},
		"ParallelismPerRPC": 20,
		"debugAddr": ":8003",
		"lagFactor": "200ms",
		"tls": {
			"caCertFile": "/certs/ipki/ca.crt",
			"certFile": "/certs/ipki/sa/cert.pem",
			"keyFile": "/certs/ipki/sa/key.pem"
		},
		"grpc": {
			"maxConnectionAge": "30s",
			"address": ":9095",
			"services": {
				"sa.StorageAuthority": {
					"clientNames": [
						"admin.boulder",
						"ca.boulder",
						"crl-updater.boulder",
						"ra.boulder"
					]
				},
				"sa.StorageAuthorityReadOnly": {
					"clientNames": [
						"admin.boulder",
						"wfe.boulder",
						"boulder-wfe2",
						"sfe.boulder",
						"boulder-sfe"
					]
				},
				"grpc.health.v1.Health": {
					"clientNames": [
						"health-checker.boulder"
					]
				}
			}
		},
		"features": {
			"MultipleCertificateProfiles": true,
			"InsertAuthzsIndividually": true,
			"IgnoreAccountContacts": true
		}
	},
	"syslog": {
		"stdoutlevel": 6,
		"sysloglevel": -1
	}
}
