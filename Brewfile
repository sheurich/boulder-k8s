# Brewfile for Boulder-K8s Development Environment
# Install all prerequisites with: brew bundle

# Core development tools
brew "just"                # Task runner and automation
brew "kubernetes-cli"      # Kubernetes CLI (kubectl)
brew "helm"                # Kubernetes package manager
brew "kind"                # Local Kubernetes clusters
brew "git"                 # Version control

# Container runtime
brew "docker"              # Docker CLI and runtime
brew "docker-compose"      # Docker Compose for multi-container apps

# Optional but recommended tools
brew "kubectx"             # Kubernetes context/namespace switching
brew "yq"                  # YAML processor (useful for debugging manifests)
brew "jq"                  # JSON processor
