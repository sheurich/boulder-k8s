#!/bin/bash
set -e

# --- Configuration ---
CLUSTER_NAME="boulder-k8s"
HELM_RELEASE_NAME="boulder"
IMAGE_TAG="local"
IMAGE_NAME="boulder"
TEST_JOB_LABEL="job-name=${HELM_RELEASE_NAME}-test"

# --- Helper Functions ---
info() {
    echo "---"
    echo "$@"
    echo "---"
}

check_dependencies() {
    info "Checking for dependencies..."
    if ! command -v docker &> /dev/null; then
        echo "Error: docker is not installed." >&2
        exit 1
    fi
    if ! command -v helm &> /dev/null; then
        echo "Error: helm is not installed." >&2
        exit 1
    fi
    if ! command -v kind &> /dev/null; then
        echo "Error: kind is not installed. See https://kind.sigs.k8s.io/docs/user/quick-start/#installation" >&2
        exit 1
    fi
    echo "All dependencies are installed."
}

cleanup() {
    EXIT_CODE=$?
    trap '' INT TERM

    if [ "$EXIT_CODE" -ne 0 ]; then
        info "A command failed. Describing test pod:"
        kubectl describe pod -l "${TEST_JOB_LABEL}" || true
        info "Getting test pod logs:"
        kubectl logs -l "${TEST_JOB_LABEL}" || true
    fi

    if [ "${PERFORM_CLEANUP}" = "true" ]; then
        info "Cleaning up resources..."
        helm uninstall "${HELM_RELEASE_NAME}" >/dev/null 2>&1 || true
        kind delete cluster --name "${CLUSTER_NAME}" >/dev/null 2>&1 || true
    fi

    trap - INT TERM
    exit $EXIT_CODE
}

# --- Main Script ---
trap cleanup EXIT

PERFORM_CLEANUP="false"
if [ "$1" = "--cleanup" ]; then
    PERFORM_CLEANUP="true"
fi

check_dependencies

info "Provisioning cluster..."
hack/provision-kind.sh

info "Building Docker image..."
docker build --file=boulder.dockerfile --tag="${IMAGE_NAME}:${IMAGE_TAG}" .

info "Loading Docker image into kind cluster..."
kind load docker-image "${IMAGE_NAME}:${IMAGE_TAG}" --name "${CLUSTER_NAME}"

info "Updating Helm dependencies..."
helm dependency update charts/boulder

info "Installing Helm chart..."
helm upgrade --install "${HELM_RELEASE_NAME}" charts/boulder \
    --wait \
    --set image.tag="${IMAGE_TAG}" \
    --set image.repository="${IMAGE_NAME}" \
    --set mariadb.enabled=true \
    --set redis.enabled=true \
    --set consul.enabled=true \
    --set jaeger.enabled=true

info "Running Helm tests..."
helm test "${HELM_RELEASE_NAME}" --debug

info "Tests passed!"
